# ============================================================
# Variables de entorno del backend Kubo en producción.
#
# Uso:
#   cp kubo.env.example kubo.env
#   # edita kubo.env con los valores reales
#   scp -i "/ruta/a/tu/llave.pem" kubo.env ecs-user@TU_SERVIDOR:/home/ecs-user/kubo.env
#   ssh -i "/ruta/a/tu/llave.pem" ecs-user@TU_SERVIDOR "chmod 600 /home/ecs-user/kubo.env"
#
# NO subas kubo.env al repositorio: está en .gitignore.
# Este archivo se pasa al contenedor con --env-file.
# ============================================================

# --- Claude ---
# Obligatoria. Solo existe en el backend.
ANTHROPIC_API_KEY=sk-ant-reemplaza-esta-clave

# Modelo principal. Alternativa económica: claude-haiku-5-5
CLAUDE_MODEL=claude-haiku-5-5

# Límites del chat
CHAT_MAX_TOKENS=2048
# Solicitudes por minuto por usuario autenticado o por IP (invitados).
CHAT_RATE_LIMIT=20
CHAT_MAX_MESSAGE_CHARS=2000
CHAT_MAX_HISTORY_MESSAGES=12
CHAT_MAX_HISTORY_CHARS=12000
CHAT_LLM_TIMEOUT=60s

# --- Base de datos de solo lectura del chat ---
# Usuario chat_ro. Requiere las migraciones 30-34 y su contraseña asignada.
# Usa el mismo host/puerto que ya usa el backend para PostgreSQL.
# Si el backend corre en el contenedor y la BD está en el host, NO uses
# localhost: usa la IP o el hostname alcanzable desde el contenedor.
CHAT_DB_URL=postgres://chat_ro:CAMBIAR_PASSWORD@HOST:5432/kubo_db?sslmode=prefer

# --- Base de datos de auditoría del chat ---
# Usuario chat_audit (solo INSERT). Requiere las migraciones 35-36.
# Si se omite, el chat funciona pero no guarda auditoría ni permite escalar.
CHAT_AUDIT_DB_URL=postgres://chat_audit:CAMBIAR_PASSWORD@HOST:5432/kubo_db?sslmode=prefer

# Destinatarios del correo de escalamientos. Si se omite, se usan los
# default_recipients de configs/cloud/email.yaml.
# CHAT_ESCALATION_EMAILS=ventas@arsenalwelds.com,atencion@arsenalwelds.com

# URL del panel que se incluye en el correo de escalamiento.
CHAT_ADMIN_PANEL_URL=https://tudominio.com/index.html#/app/dashboard

# Opcional: para pruebas contra un servidor compatible o un mock local.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
