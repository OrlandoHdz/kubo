# ============================================================
# Chat inteligente de Kubo
# Copia este archivo a .env y coloca valores reales SOLO en local.
# .env está ignorado por git. No subas secretos al repositorio.
# ============================================================

# --- Claude ---
# Obligatoria. Solo existe en el backend.
ANTHROPIC_API_KEY=sk-ant-reemplaza-esta-clave

# Modelo principal. Alternativa económica: claude-haiku-5-5
CLAUDE_MODEL=claude-haiku-5-5

# Límites del chat
CHAT_MAX_TOKENS=2048
# Solicitudes por minuto por usuario autenticado o por IP (invitados).
CHAT_RATE_LIMIT=20
CHAT_MAX_MESSAGE_CHARS=2000
CHAT_MAX_HISTORY_MESSAGES=12
CHAT_MAX_HISTORY_CHARS=12000
CHAT_LLM_TIMEOUT=60s

# --- Base de datos de solo lectura ---
# Usuario chat_ro. Requiere haber aplicado las migraciones 30-34 y
# asignado contraseña con: ALTER ROLE chat_ro WITH PASSWORD '...';
# En producción usa sslmode=require o verify-full.
CHAT_DB_URL=postgres://chat_ro:CAMBIAR_PASSWORD@localhost:5432/kubo_db?sslmode=disable

# --- Base de datos de auditoría ---
# Usuario chat_audit (solo INSERT). Requiere migraciones 35-36.
# Si se omite, el chat funciona pero no guarda auditoría ni permite escalar.
CHAT_AUDIT_DB_URL=postgres://chat_audit:CAMBIAR_PASSWORD@localhost:5432/kubo_db?sslmode=disable

# Destinatarios del correo de escalamientos del chat. Si se omite,
# se usan los default_recipients de configs/cloud/email.yaml.
# CHAT_ESCALATION_EMAILS=ventas@arsenalwelds.com,atencion@arsenalwelds.com

# URL del panel que se incluye en el correo de escalamiento.
CHAT_ADMIN_PANEL_URL=http://localhost:9000/#/app/dashboard

# Opcional: para pruebas contra un servidor compatible o un mock local.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
