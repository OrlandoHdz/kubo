# URL de producción con un rol que tenga permisos de migración (DDL,
# creación de roles y, si aplica, creación de extensiones).
# No uses chat_ro/chat_audit ni un rol de solo lectura.
# sslmode=prefer intenta SSL y cae a conexión sin SSL si el servidor no lo soporta.
MIGRATION_DATABASE_URL=postgres://usuario_admin:password@host:5432/kubo_db?sslmode=prefer

# Directorio donde se guardan los respaldos pg_dump antes de migrar.
MIGRATION_BACKUP_DIR=backups
